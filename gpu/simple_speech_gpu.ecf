<?xml version="1.0" encoding="ISO-8859-1"?>
<system xmlns="http://www.eiffel.com/developers/xml/configuration-1-23-0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.eiffel.com/developers/xml/configuration-1-23-0 http://www.eiffel.com/developers/xml/configuration-1-23-0.xsd" name="simple_speech_gpu" uuid="3A2508C4-6431-4D73-8F95-573F790D7D34" library_target="simple_speech_gpu">
	<description>Live speech on the GPU: whisper.cpp 1.8.2 (CUDA build) sliding-window recognition with word times, and Silero voice activity. Separate from simple_speech.ecf, whose CPU whisper is linked statically under the same symbol names.</description>
	<!-- Run time: whisper.dll, ggml.dll, ggml-base.dll, ggml-cpu.dll, ggml-cuda.dll from
	     whisper_cpp_build/build_cuda/bin beside the exe, and the CUDA 13 runtime
	     (cudart64_13, cublas64_13, cublasLt64_13) on PATH or beside the exe. -->
	<target name="simple_speech_gpu">
		<root all_classes="true"/>
		<file_rule>
			<exclude>/EIFGENs$</exclude>
		</file_rule>
		<option warning="warning">
			<assertions precondition="true" postcondition="true" check="true" invariant="true" loop="true" supplier_precondition="true"/>
		</option>
		<setting name="dead_code_removal" value="feature"/>
		<capability>
			<concurrency support="scoop" use="scoop"/>
			<void_safety support="all"/>
		</capability>
		<external_include location="$(SIMPLE_EIFFEL)/simple_speech/gpu/Clib"/>
		<external_include location="$(SIMPLE_EIFFEL)/whisper_cpp_build/include"/>
		<external_include location="$(SIMPLE_EIFFEL)/whisper_cpp_build/ggml/include"/>
		<external_object location="$(SIMPLE_EIFFEL)/whisper_cpp_build/build_cuda/src/whisper.lib">
			<condition>
				<platform value="windows"/>
			</condition>
		</external_object>
		<external_object location="$(SIMPLE_EIFFEL)/whisper_cpp_build/build_cuda/ggml/src/ggml.lib">
			<condition>
				<platform value="windows"/>
			</condition>
		</external_object>
		<external_object location="$(SIMPLE_EIFFEL)/whisper_cpp_build/build_cuda/ggml/src/ggml-base.lib">
			<condition>
				<platform value="windows"/>
			</condition>
		</external_object>
		<library name="base" location="$ISE_LIBRARY\library\base\base.ecf"/>
		<cluster name="src" location=".\src\" recursive="true"/>
	</target>
	<target name="simple_speech_gpu_tests" extends="simple_speech_gpu">
		<root class="TEST_APP" feature="make"/>
		<setting name="console_application" value="true"/>
		<!-- Repeated: an extending target's clusters do not inherit the parent's assertions. -->
		<option warning="warning">
			<assertions precondition="true" postcondition="true" check="true" invariant="true" loop="true" supplier_precondition="true"/>
		</option>
		<library name="simple_testing" location="$SIMPLE_EIFFEL\simple_testing\simple_testing.ecf"/>
		<library name="testing" location="$ISE_LIBRARY\library\testing\testing.ecf"/>
		<cluster name="tests" location=".\testing\" recursive="true"/>
	</target>
</system>
